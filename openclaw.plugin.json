{
  "id": "openclaw-persistio-v2",
  "name": "Persistio Memory v2",
  "description": "OpenClaw-native long-term memory powered by Persistio",
  "version": "0.2.0",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_recall",
      "memory_store",
      "memory_forget"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseURL": {
        "type": "string"
      },
      "apiKey": {
        "type": "string"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "recall": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": {
            "type": "number",
            "minimum": 1
          },
          "maxResults": {
            "type": "number",
            "minimum": 1
          },
          "tokenBudget": {
            "type": "number",
            "minimum": 1
          },
          "minSimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "includePending": {
            "type": "boolean"
          },
          "includeRelated": {
            "type": "boolean"
          },
          "queryMaxChars": {
            "type": "number",
            "minimum": 100
          }
        }
      },
      "capture": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": {
            "type": "number",
            "minimum": 1
          },
          "maxCharsPerTurn": {
            "type": "number",
            "minimum": 1
          },
          "maxCharsPerMessage": {
            "type": "number",
            "minimum": 1
          },
          "maxChunksPerTurn": {
            "type": "number",
            "minimum": 1
          },
          "maxChunkChars": {
            "type": "number",
            "minimum": 256
          },
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "type": "string",
                "enum": ["enabled", "disabled"]
              },
              "assistant": {
                "type": "string",
                "enum": ["enabled", "bounded", "disabled"]
              },
              "tool": {
                "type": "string",
                "enum": ["enabled", "disabled"]
              }
            }
          }
        }
      }
    },
    "required": [
      "baseURL",
      "apiKey"
    ]
  },
  "uiHints": {
    "apiKey": {
      "label": "Vault API Key",
      "sensitive": true
    },
    "baseURL": {
      "label": "Persistio Base URL",
      "placeholder": "https://api.persistio.ai"
    },
    "autoRecall": {
      "label": "Auto Recall",
      "help": "Inject a small bounded Persistio memory block before each turn"
    },
    "autoCapture": {
      "label": "Auto Capture",
      "help": "Capture bounded durable conversation facts after successful turns"
    }
  }
}
