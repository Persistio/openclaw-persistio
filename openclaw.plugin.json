{
  "id": "openclaw-persistio",
  "name": "Persistio Memory",
  "description": "Persistent semantic memory for OpenClaw via Persistio",
  "version": "0.1.8",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "persistio_memory_add",
      "persistio_memory_delete",
      "persistio_memory_list"
    ]
  },
  "toolMetadata": {
    "persistio_memory_add": {
      "optional": true
    },
    "persistio_memory_delete": {
      "optional": true
    },
    "persistio_memory_list": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseURL": {
        "type": "string"
      },
      "apiKey": {
        "type": "string"
      },
      "tokenBudget": {
        "type": "number",
        "minimum": 1
      },
      "recallTopK": {
        "type": "number",
        "minimum": 1
      },
      "recallMinSimilarity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "recallTimeout": {
        "type": "number",
        "minimum": 1
      },
      "recallIncludePending": {
        "type": "boolean"
      },
      "includeRelatedMemories": {
        "type": "boolean"
      },
      "ingest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeoutMs": {
            "type": "number",
            "minimum": 1
          },
          "maxChunkChars": {
            "type": "number",
            "minimum": 256
          },
          "maxChunksPerTurn": {
            "type": "number",
            "minimum": 1
          },
          "skipSubagentSessions": {
            "type": "boolean"
          },
          "user": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxCharsPerMessage": {
                "type": "number",
                "minimum": 1
              }
            }
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "bounded",
                  "raw"
                ]
              },
              "maxCharsPerMessage": {
                "type": "number",
                "minimum": 1
              },
              "maxCharsAfterFiltering": {
                "type": "number",
                "minimum": 1
              },
              "maxCharsPerTurn": {
                "type": "number",
                "minimum": 1
              },
              "largeBlockThresholdChars": {
                "type": "number",
                "minimum": 1
              },
              "largeBlockThresholdLines": {
                "type": "number",
                "minimum": 1
              },
              "maxTableRows": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        }
      },
      "send": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "roles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              },
              "agent": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              },
              "tool": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          }
        }
      }
    },
    "required": [
      "baseURL",
      "apiKey"
    ]
  }
}
